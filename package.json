{
  "name": "aura-voice-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "concurrently \"npm:server\" \"npm:frontend\"",
    "server": "cd server && npm run dev",
    "frontend": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run --coverage"
  },
  "dependencies": {
    "autoprefixer": "^10.4.0",
    "lucide-react": "^0.344.0",
    "next": "^14.0.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^8.2.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}